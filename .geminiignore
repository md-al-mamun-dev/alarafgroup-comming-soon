# Gemini Ignore File
# Exclude sensitive, high-noise, or generated files from Gemini context

# Secrets and Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
# Do NOT exclude .env.example

# Build Output and Caches
.next/
out/
build/
coverage/
.turbo/
.vercel/

# Dependencies
node_modules/
.pnp*
.yarn/

# Logs and Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.sql
*.sqlite
*.db

# OS Files
.DS_Store
Thumbs.db

